# Copy to .env and fill in what you have. Empty values are fine: the proxy
# starts without them and simply omits that provider. Never commit .env.
#
# Generate the proxy secrets with:
#   openssl rand -hex 32

# Required before the port is reachable from anything but localhost.
# Sent as Authorization: Bearer <this value>.
LITELLM_MASTER_KEY=

# Only used with docker-compose.spend.yml. Set once; do not change it later.
LITELLM_SALT_KEY=
POSTGRES_PASSWORD=

# Daily spending cap for paid providers (Novita, DeepSeek, Voyage, NVIDIA NIM,
# SiliconFlow), in US dollars, across all apps, for your local calendar day.
# Default 0.9375 (NT$30 at 32, the limit the app shows a new user). 0 = never pay. Anything unparsable or negative counts as 0.
# Paid deployments are used only when every free, trial and local one has
# failed, only by apps with allow_paid, and only when the catalogue gives
# them a `price:` (a paid model without one is used only by its direct name).
MUSE_DAILY_PAID_CAP_USD=
# Override for whether paid providers join the public aliases. Empty = follow
# the cap (join when the cap is > 0). false = never join (direct names still
# work, still under the cap). true = always join (the cap still applies).
MUSE_ALLOW_PAID_FALLBACK=

# Comma-separated provider ids to ignore even if the key is set.
# Example: groq,novita
MUSE_DISABLE_PROVIDERS=

# Bind address published on the host. Keep the default on a public VM.
MUSE_BIND=127.0.0.1
MUSE_PORT=4000
LITELLM_NUM_WORKERS=1

# --- Chat, embeddings, rerank (LiteLLM) ---

# Google AI Studio, free tier. https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Groq. https://console.groq.com/keys
GROQ_API_KEY=

# OpenRouter, free-model fallback. https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Cohere trial key (chat, embed, rerank). https://dashboard.cohere.com/api-keys
COHERE_API_KEY=

# Cerebras Inference. Not a free tier: a one-time $5 credit after a payment
# method, expiring in 30 days. Direct model names only; not in the free aliases.
# https://cloud.cerebras.ai
CEREBRAS_API_KEY=

# SambaNova Cloud free tier (no card): about 20 requests a minute and 20 a day.
# Empty until you create a key. https://cloud.sambanova.ai/
SAMBANOVA_API_KEY=

# Cloudflare Workers AI, free plan (10,000 neurons a day). Needs both values:
# an API token and your Account ID. https://dash.cloudflare.com/
CLOUDFLARE_API_KEY=
CLOUDFLARE_ACCOUNT_ID=

# Novita, paid/cheap. https://novita.ai/settings/key-management
NOVITA_API_KEY=

# SiliconFlow international account. https://cloud.siliconflow.com/account/ak
# Mainland accounts use the same variable; the proxy calls https://api.siliconflow.com/v1
SILICONFLOW_API_KEY=

# DeepSeek, paid. https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# Voyage embeddings and rerank, paid. https://dash.voyageai.com/api-keys
VOYAGE_API_KEY=

# Jina embeddings and rerank. https://jina.ai/api-dashboard
# LiteLLM also accepts JINA_AI_API_KEY. This stack reads JINA_API_KEY.
JINA_API_KEY=

# NVIDIA NIM, optional credits. https://build.nvidia.com/settings/api-keys
NVIDIA_NIM_API_KEY=

# --- Speech, called directly (not routed by this proxy) ---
# See README, "Speech". Leave blank until you wire a client yourself.

# Deepgram speech-to-text. https://console.deepgram.com/signup
DEEPGRAM_API_KEY=

# ElevenLabs text-to-speech. https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# AssemblyAI speech-to-text. https://www.assemblyai.com/app/account
ASSEMBLYAI_API_KEY=

# --- Local models (no key). Set a base URL to enable, then run `muse local discover`.
# From inside the Docker container use http://host.docker.internal:11434 etc.
OLLAMA_API_BASE=
LM_STUDIO_API_BASE=
MUSE_LOCAL_OPENAI_BASE=
# Where local models sit in each alias. 5 = after the free cloud tiers, before
# OpenRouter. 0 = try local first.
MUSE_LOCAL_ORDER=5

# --- Resource manager
# State (usage ledger, local model list). Default ~/.muse
MUSE_HOME=
# Privacy class used when a request does not send x-muse-privacy:
# public | standard | private | local
MUSE_DEFAULT_PRIVACY=standard

# Seconds the proxy keeps a failed deployment out when the provider sent no
# Retry-After (1-3600; empty = 30). A provider's Retry-After always wins.
MUSE_COOLDOWN_FALLBACK_S=

# --- Rationing between apps (register apps with `muse apps add`; MUSE_HOME/apps.yaml)
# Time zone for "today" in per-app caps and the paid cap, e.g. Asia/Taipei.
# Empty = the system zone; inside the Docker container that is usually UTC,
# so set this.
MUSE_TZ=
# A background app skips an upstream an interactive app used in the last N seconds.
MUSE_ACTIVE_WINDOW_S=120
# Share of a known quota kept back from background (0.30) and normal (0.10) apps.
MUSE_RESERVE_BACKGROUND=0.30
MUSE_RESERVE_NORMAL=0.10
# The reserve is waived this close to a reset, so quota is not wasted:
# daily windows (seconds, default 3600) and monthly windows (default 86400).
MUSE_EXPIRING_DAY_S=3600
MUSE_EXPIRING_MONTH_S=86400
# false = background jobs may share a local model with the active app.
MUSE_LOCAL_YIELD=true
