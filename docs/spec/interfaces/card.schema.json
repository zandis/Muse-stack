{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://muse.invalid/spec/interfaces/card.schema.json",
  "title": "Card",
  "description": "One question the home asks the person before it acts (docs/spec/02-ux.md section 5). Written by muse/home/cards.py; a test validates the store's output against this file. Every text field is plain text: render it with textContent, never as HTML. No field ever holds a key or token.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "kind",
    "title",
    "thing",
    "where",
    "under",
    "cost",
    "extra",
    "created_at",
    "expires_at",
    "status",
    "answered_at",
    "answered_by",
    "always",
    "job_ref",
    "title_key",
    "params"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[0-9a-f]{16}$"
    },
    "kind": {
      "enum": [
        "save_file",
        "message",
        "spend",
        "grant_permission",
        "oneoff_credit",
        "send_private",
        "install_skill"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "description": "What will happen, as a verb phrase: \"Save a file\"."
    },
    "thing": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "The thing acted on: a file name, a message subject, a service."
    },
    "where": {
      "type": "string",
      "minLength": 0,
      "maxLength": 200,
      "description": "Where it goes. May be empty."
    },
    "under": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "mandate_id"
      ],
      "description": "Which permission or chore this runs under.",
      "properties": {
        "text": {
          "type": "string",
          "minLength": 0,
          "maxLength": 200
        },
        "mandate_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/ref"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "cost": {
      "description": "Always present: an amount, or nothing.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "nothing"
          ],
          "properties": {
            "nothing": {
              "const": true
            }
          }
        },
        {
          "$ref": "#/$defs/money"
        }
      ]
    },
    "extra": {
      "type": "object",
      "description": "The kind-specific line; its shape depends on kind (see allOf)."
    },
    "created_at": {
      "$ref": "#/$defs/time"
    },
    "expires_at": {
      "$ref": "#/$defs/time",
      "description": "Default 24 hours after created_at; 5 minutes for spend."
    },
    "status": {
      "enum": [
        "pending",
        "approved",
        "declined",
        "expired"
      ]
    },
    "answered_at": {
      "anyOf": [
        {
          "$ref": "#/$defs/time"
        },
        {
          "type": "null"
        }
      ]
    },
    "answered_by": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        {
          "type": "null"
        }
      ],
      "description": "The name of the device that answered."
    },
    "always": {
      "type": "boolean",
      "description": "The person chose \"Always allow this\" when approving."
    },
    "job_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/ref"
        },
        {
          "type": "null"
        }
      ],
      "description": "Opaque to clients: what on the home is waiting for the answer."
    },
    "title_key": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,39}$"
        },
        {
          "type": "null"
        }
      ],
      "description": "Null on most cards. Set on the home's own cards (a chore's, a skill's): the name of a sentence the app has in every language. The app shows that sentence, filled with `params`, in place of `title` and `under.text`, and falls back to them when it does not know the key. Cards a host bot asked for never have one. Known keys: save_file_chore (params: label), save_file_skill (params: skill)."
    },
    "params": {
      "type": "object",
      "description": "The plain values the sentence of `title_key` is filled with: at most 8, each a name of lower-case letters, digits and '_' with one line of text (200 characters at most) or a number. Empty without a title_key."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "save_file"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "extra": {
            "type": "object",
            "additionalProperties": false,
            "required": [],
            "properties": {
              "size_bytes": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "message"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "extra": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "preview"
            ],
            "properties": {
              "preview": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500,
                "description": "The first lines of the text."
              },
              "to": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "draft": {
                "type": "boolean",
                "description": "true: only a draft is saved; false or absent: it is sent."
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "spend"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "extra": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "payee",
              "limit_left"
            ],
            "properties": {
              "payee": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "limit_left": {
                "$ref": "#/$defs/money",
                "description": "What is left of today's limit before this payment."
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "grant_permission"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "extra": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "sentence",
              "limits",
              "ends_at"
            ],
            "properties": {
              "sentence": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              },
              "limits": {
                "type": "array",
                "minItems": 0,
                "maxItems": 12,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                }
              },
              "ends_at": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/time"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "oneoff_credit"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "extra": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "service"
            ],
            "properties": {
              "service": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "credit_left": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "send_private"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "extra": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "badge",
              "services"
            ],
            "properties": {
              "badge": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200,
                "description": "The privacy badge the request needs."
              },
              "services": {
                "type": "array",
                "minItems": 1,
                "maxItems": 12,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "description": "The services that qualify."
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "install_skill"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "extra": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "asks_for",
              "author"
            ],
            "properties": {
              "asks_for": {
                "type": "array",
                "minItems": 1,
                "maxItems": 12,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "description": "What the skill asks for, line by line."
              },
              "author": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "spend"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "cost": {
            "$ref": "#/$defs/money"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "pending",
              "expired"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "answered_at": {
            "type": "null"
          },
          "answered_by": {
            "type": "null"
          },
          "always": {
            "const": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "declined"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "always": {
            "const": false
          }
        }
      }
    }
  ],
  "$defs": {
    "money": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "amount",
        "currency"
      ],
      "properties": {
        "amount": {
          "type": "string",
          "pattern": "^(?:0|[1-9][0-9]{0,11})(?:\\.[0-9]{1,8})?$",
          "description": "A decimal number as text, so no device rounds money."
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9]{2,7}$",
          "description": "A code such as TWD, USD or USDC."
        }
      }
    },
    "time": {
      "type": "string",
      "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\dZ$",
      "description": "UTC, to the second."
    },
    "ref": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,128}$"
    }
  }
}
