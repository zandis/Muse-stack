# Optional ping of the URL in MUSE_HEARTBEAT_URL_FILE. Does nothing when that
# file is missing. The URL is not put in this unit: the script reads the file
# and does not print it.
[Unit]
Description=Wardmuse heartbeat
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=@MUSE_USER@
Group=@MUSE_USER@
WorkingDirectory=@MUSE_ROOT@
EnvironmentFile=-@MUSE_CONF@
Environment=PATH=@MUSE_VENV@/bin:/usr/bin:/bin
Environment=PYTHONUNBUFFERED=1
ExecStart=/bin/bash @MUSE_ROOT@/deploy/vm/muse-heartbeat.sh
TimeoutStartSec=1min
MemoryMax=128M
CPUQuota=10%
TasksMax=32
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=@PROTECT_HOME@
ReadWritePaths=@MUSE_STATE@
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
UMask=0077
