# One pass over the chores that are due (docs/chores.md). Started every minute
# by wardmuse-chores.timer; a pass that is still running is not started twice.
[Unit]
Description=Wardmuse chores: one pass
After=wardmuse-proxy.service

[Service]
Type=oneshot
User=@MUSE_USER@
Group=@MUSE_USER@
WorkingDirectory=@MUSE_ROOT@
EnvironmentFile=-@MUSE_CONF@
Environment=PATH=@MUSE_VENV@/bin:/usr/bin:/bin
Environment=PYTHONPATH=@MUSE_ROOT@
Environment=PYTHONUNBUFFERED=1
ExecStart=@MUSE_VENV@/bin/python -m wardmuse chores tick
TimeoutStartSec=30min
MemoryMax=1G
CPUQuota=100%
TasksMax=128
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=@PROTECT_HOME@
ReadWritePaths=@MUSE_STATE@
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
UMask=0077
