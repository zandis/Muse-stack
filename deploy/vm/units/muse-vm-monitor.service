# Samples CPU, memory and network once a minute for muse-vm-status, and runs
# the idle guard: when memory in use would stay under the level Oracle treats
# as idle, it holds the difference (and gives it back as soon as real work
# needs it). No network access at all. See deploy/vm/muse-vm-monitor.py.
[Unit]
Description=Muse VM monitor and idle guard

[Service]
Type=simple
User=@MUSE_USER@
Group=@MUSE_USER@
EnvironmentFile=-@MUSE_CONF@
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 @MUSE_ROOT@/deploy/vm/muse-vm-monitor.py
Restart=always
RestartSec=30
MemoryMax=4G
MemorySwapMax=0
CPUQuota=10%
TasksMax=8
OOMScoreAdjust=1000
Nice=19
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=@PROTECT_HOME@
ReadWritePaths=@MUSE_STATE@
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
UMask=0077

[Install]
WantedBy=multi-user.target
