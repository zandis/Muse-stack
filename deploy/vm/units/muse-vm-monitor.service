# Samples CPU, memory and network once a minute for muse-vm-status, and runs
# the idle guard: when no minute in the last ten reached the target processor
# use by itself, it keeps the processor near that target for one minute, at
# the lowest priority, and stops as soon as real work needs the processor.
# It never holds memory and has no network access at all. On by default for
# an Always Free account, off for a paid one. See deploy/vm/muse-vm-monitor.py.
[Unit]
Description=Muse VM monitor and idle guard

[Service]
Type=simple
User=@MUSE_USER@
Group=@MUSE_USER@
EnvironmentFile=-@MUSE_CONF@
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 @MUSE_ROOT@/deploy/vm/muse-vm-monitor.py
Restart=always
RestartSec=30
MemoryMax=128M
MemorySwapMax=0
# One thread at most one core; the guard needs half a core on 2 OCPUs.
CPUQuota=100%
CPUWeight=1
TasksMax=8
OOMScoreAdjust=1000
Nice=19
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=@PROTECT_HOME@
ReadWritePaths=@MUSE_STATE@
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
UMask=0077

[Install]
WantedBy=multi-user.target
